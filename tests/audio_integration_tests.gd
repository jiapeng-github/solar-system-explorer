extends SceneTree
var app
var heard: Array[String] = []
var failures: Array[String] = []
var visual := false
func _initialize() -> void:
	visual = "--visual" in OS.get_cmdline_user_args()
	call_deferred("run")
func check(ok: bool, message: String) -> void:
	if not ok: failures.append(message); push_error(message)
func expect(cues: Array, message: String) -> void:
	for i in range(4): await process_frame
	check(heard == cues,message+": "+str(heard))
	heard.clear()
	app.audio._last_played.clear()
func find_button(node: Node, caption: String) -> Button:
	if node is Button and node.text == caption: return node
	for child in node.get_children():
		var found := find_button(child,caption)
		if found != null: return found
	return null
func shot(file_name: String) -> void:
	for i in range(12): await process_frame
	if not visual: return
	RenderingServer.force_draw(false)
	await process_frame
	root.get_texture().get_image().save_png("res://work/audio-"+file_name+".png")
func run() -> void:
	create_timer(90).timeout.connect(func(): quit(2))
	root.size = Vector2i(1280,800)
	app = load("res://scenes/main.tscn").instantiate()
	app.progress.path = "res://work/audio-integration-progress.json"
	app.quality.path = "res://work/audio-integration-quality.cfg"
	app.audio.path = "res://work/audio-integration.cfg"
	DirAccess.remove_absolute(app.audio.path)
	app.progress.reset_progress()
	app.audio.cue_played.connect(func(cue): heard.append(cue))
	root.add_child(app)
	app._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
	await expect([],"Startup is silent")
	await shot("home-tablet")
	app._nav_buttons.home.pressed.emit()
	await expect([],"Current navigation tab is silent")
	check(app._nav_buttons.home.button_pressed,"Current navigation stays selected")
	app._nav_buttons.explore.pressed.emit()
	await expect(["navigate"],"Navigation gives one cue")
	app.world.set_process(false)
	app.world.camera._process(1)
	app._planet_buttons[4].pressed.emit()
	await expect(["select"],"Planet thumbnail selects")
	app._planet_buttons[4].pressed.emit()
	await expect([],"Current thumbnail is silent")
	app._view_buttons.close.pressed.emit()
	await expect(["focus"],"Enter close-up")
	app.world.camera._process(1)
	app._planet_buttons[5].pressed.emit()
	await expect(["select"],"Close-up thumbnail remains a selection cue")
	app._view_buttons.close.pressed.emit()
	await expect([],"Already in close-up stays silent")
	app._region_buttons.inner.pressed.emit()
	await expect(["select"],"Region and automatic planet change give one cue")
	app._region_buttons.inner.pressed.emit()
	await expect([],"Unchanged region is silent")
	app.world.camera._process(1)
	app._zoom_from_ui(1.2)
	await expect(["adjust"],"Zoom button feedback")
	app.world.camera.distance = app.world.camera.max_distance
	app._zoom_from_ui(1.2)
	await expect([],"Zoom boundary is silent")
	app.world.camera.zoom_by(0.9)
	await expect([],"Gesture/model zoom is silent")
	app.world.days_per_second = 12.0
	app._choose_speed(0)
	await expect(["select"],"Speed change feedback")
	app._choose_speed(0)
	await expect([],"Unchanged speed silent")
	app.world.paused = false
	app._toggle_pause()
	await expect(["toggle_off"],"Pause feedback")
	app._toggle_pause()
	await expect(["toggle_on"],"Resume feedback")
	app.navigate("compare")
	await expect([],"Programmatic navigation is silent")
	find_button(app._compare_info,"⇄  交换比较对象").pressed.emit()
	await expect(["swap"],"Sidebar swap gives exactly one cue")
	app._choose_comparison(0,app._compare_second)
	app._swap_comparison(true)
	await expect([],"Identical comparison swap is silent")
	app._choose_comparison(0,3,true)
	await expect(["select"],"Compare selection")
	app._select_comparison_slot(1,true)
	await expect(["select"],"Comparison target slot")
	app._open_lesson("day")
	await expect([],"Day initialization silent")
	app._slider.value = 42
	await expect([],"Slider values don't sound during movement")
	app._slider.drag_ended.emit(true)
	await expect(["adjust"],"Slider release sounds once")
	app._answer_buttons[1].pressed.emit()
	await expect(["retry"],"Wrong answer")
	app._answer_buttons[1].pressed.emit()
	await expect([],"Same submitted answer silent")
	app._answer_buttons[0].pressed.emit()
	await expect(["complete"],"First correct day answer replaces correct with complete")
	app.navigate("lab")
	await expect([],"Restoring answered experiment silent")
	app._answer_buttons[0].pressed.emit()
	await expect([],"Restored same answer silent")
	app._open_lesson("year")
	await expect([],"Year initialization silent")
	app._slider.drag_started.emit()
	app._slider.value = 360
	await expect([],"Year completion doesn't sound mid-drag")
	app._slider.drag_ended.emit(true)
	await expect(["complete"],"Year release rewards once, replaces adjust")
	app.navigate("lab")
	await expect([],"Restored full orbit silent")
	app.progress.data.lessons.erase("year")
	app._change_angle(359)
	app._set_playing(true)
	app._process(1)
	await expect(["complete"],"Playing full orbit rewards once")
	app.navigate("knowledge")
	find_button(app._body,"展开 · 内部结构").toggled.emit(true)
	await expect(["toggle_on"],"Knowledge expansion feedback")
	app._show_sources()
	await expect(["tap"],"Sources open feedback")
	app._sources.dismiss()
	await expect(["back"],"Sources close feedback")
	for planet in app.catalog: app.progress.visit(planet.id)
	app.progress.record_comparison("rotation:earth:mars")
	app.progress.record_comparison("size:earth:jupiter")
	app.navigate("progress")
	app._body.get_node("ProgressPage").open_quiz(1)
	await expect(["tap"],"Task quiz open")
	app._body.get_node("ProgressPage").answer_buttons[0].pressed.emit()
	await expect(["retry"],"Task wrong answer doesn't play open cue")
	app._body.get_node("ProgressPage").answer_buttons[0].pressed.emit()
	await expect([],"Repeated task answer silent")
	app._body.get_node("ProgressPage").answer_buttons[1].pressed.emit()
	await expect(["complete"],"Task correct answer rewards once")
	app._body.get_node("ProgressPage").quiz.dismiss()
	await expect(["back"],"Task close feedback")
	app._sound_button.pressed.emit()
	await expect([],"Muting is silent")
	app._nav_buttons.home.pressed.emit()
	await expect([],"Muted navigation silent")
	app._reset_learning()
	check(not app.audio.enabled,"Learning reset retains mute preference")
	app._sound_button.pressed.emit()
	await expect(["tap"],"Enabling has one audition tap")
	app.audio.request("select")
	app._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	await expect([],"Background clears pending audio")
	app._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
	await expect([],"Foreground never replays")
	app.audio.request("tap")
	app._notification(Node.NOTIFICATION_APPLICATION_PAUSED)
	await expect([],"Android background suspends sounds")
	app._notification(Node.NOTIFICATION_APPLICATION_RESUMED)
	await expect([],"Android resume never replays")
	app._reset_dialog.popup_centered()
	await expect(["tap"],"Reset confirmation open")
	find_button(app._reset_dialog,"确认重置").pressed.emit()
	await expect(["reset"],"Confirmed reset replaces close sound")
	for dimensions in [Vector2i(800,1100),Vector2i(390,844)]:
		root.size = dimensions
		app.navigate("home")
		await shot("home-"+str(dimensions.x))
		check(app._sound_button.get_parent() == app._brand_row,"Narrow screen mute uses brand row")
		check(app._header.get_global_rect().end.x <= app.size.x,"Header fits screen")
		check(app._sound_button.size.x >= 44 and app._sound_button.size.y >= 44,"Mute hit area")
	print("PASS: all-page audio actions, no-op/restore silence, first completion, mute and responsive header" if failures.is_empty() else str(failures))
	app.queue_free()
	for i in range(4): await process_frame
	await create_timer(0.05).timeout
	quit(0 if failures.is_empty() else 1)
