extends SceneTree
const Model = preload("res://scripts/seasons_model.gd")
const Store = preload("res://scripts/progress_store.gd")
var app
var failures: Array[String] = []
func _initialize() -> void: call_deferred("run")
func check(value: bool, message: String) -> void:
	if not value: failures.append(message); push_error(message)
func frames() -> void:
	app._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
	for i in range(12): await process_frame
func shot(name: String) -> void:
	await frames()
	RenderingServer.force_draw(false)
	await process_frame
	root.get_texture().get_image().save_png("res://work/"+name+".png")
func run() -> void:
	create_timer(70).timeout.connect(func(): quit(2))
	check(is_equal_approx(Model.sunlight(0,40,23.4).hours,12),"Equinox twelve hours")
	check(Model.sunlight(90,40,23.4).hours > 14 and Model.sunlight(90,-40,23.4).hours < 10,"Opposite hemisphere solstice daylight")
	check(is_equal_approx(Model.sunlight(90,40,23.4).hours,Model.sunlight(270,-40,23.4).hours),"Solstice symmetry")
	for angle in [0,45,90,180,270,360]:
		check(is_equal_approx(Model.sunlight(angle,40,0).hours,12) and is_equal_approx(Model.sunlight(angle,40,0).altitude,50),"Zero tilt invariant")
	root.size = Vector2i(1280,800)
	app = load("res://scenes/main.tscn").instantiate()
	app.progress.path = "res://work/seasons-test-progress.json"
	app.quality.path = "res://work/seasons-test-quality.cfg"
	app.audio.path = "res://work/seasons_tests-audio.cfg"
	app.progress.reset_progress()
	app.progress.complete("day")
	app.progress.complete("year")
	root.add_child(app)
	app.audio.set_enabled(false,false)
	app._open_lesson("seasons")
	await frames()
	var lab = app._body.get_node("SeasonsLab")
	check(lab.state.visited == [1],"Opening June observes only June")
	check(lab.daylight.text == "更长" and lab.altitude.text == "更高" and lab.season_badge.text == "夏季","Northern summer indicators")
	lab.set_south(true)
	check(lab.daylight.text == "更短" and lab.altitude.text == "更低" and lab.season_badge.text == "冬季","Southern winter indicators")
	lab.set_south(false)
	await shot("seasons-v0111-observe")
	check(app._body.get_global_rect().end.y <= app._body_scroll.get_global_rect().end.y+2,"Tablet first screen fits")
	lab.answer(0)
	check(not app.progress.data.lessons.has("seasons"),"Quiz alone cannot complete")
	lab.set_tilt(0)
	check(lab.daylight.text == "不变" and lab.altitude.text == "不变","Zero tilt indicators")
	await shot("seasons-v0111-contrast")
	lab.set_tilt(23.4)
	for angle in [0,90,180,270]: lab.set_angle(angle,true)
	check(app.progress.data.lessons.has("seasons"),"Observations plus contrast plus correct answer complete")
	check(app.progress.data.lessons.has("day") and app.progress.data.lessons.has("year"),"Old completed lessons preserved")
	lab.set_south(true)
	lab.set_step(2)
	await shot("seasons-v0111-quiz")
	lab.set_playing(true)
	lab.set_angle(120,true)
	check(not lab.playing,"Manual input pauses")
	lab.set_playing(true)
	lab._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	check(not lab.playing,"Background pauses")
	app.navigate("home")
	app._open_lesson("seasons")
	await frames()
	lab = app._body.get_node("SeasonsLab")
	check(lab.state.south and lab.state.angle == 120 and lab.state.step == 2,"Navigation restores state")
	var reloaded = Store.new()
	reloaded.path = app.progress.path
	reloaded.load_progress()
	check(reloaded.data.seasons.visited.size() == 4 and reloaded.data.lessons.has("seasons"),"Progress survives reload")
	lab.reset()
	lab.set_angle(359,true)
	lab.set_playing(true)
	lab._process(1)
	check(lab.state.angle == 360 and not lab.playing,"Full year ends at next March")
	lab.reset()
	root.size = Vector2i(1280,720)
	await shot("seasons-v0111-wide")
	check(app._body.get_global_rect().end.y <= app._body_scroll.get_global_rect().end.y+2,"Wide tablet fits")
	root.size = Vector2i(390,844)
	await shot("seasons-v0111-phone")
	check(app._body.size.x <= app._body_scroll.size.x+1,"Phone width fits")
	app.navigate("progress")
	app._reset_learning()
	check(not app.progress.data.has("seasons") and app.progress.data.lessons.is_empty(),"Reset clears seasons")
	print("PASS: seasons model, completion gates, state persistence, playback and layouts" if failures.is_empty() else str(failures))
	app.queue_free()
	await process_frame
	await create_timer(.1).timeout
	quit(0 if failures.is_empty() else 1)
