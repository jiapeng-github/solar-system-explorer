extends SceneTree
const Catalog = preload("res://scripts/catalog.gd")
const Store = preload("res://scripts/progress_store.gd")
var failures: Array[String] = []
var app
var visual := false

func _initialize() -> void:
	visual = "--visual" in OS.get_cmdline_user_args()
	call_deferred("run")

func check(condition: bool, message: String) -> void:
	if not condition:
		failures.append(message)
		push_error(message)

func frames() -> void:
	if is_instance_valid(app): app._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
	for i in range(4): await process_frame
	if is_instance_valid(app) and is_instance_valid(app.world):
		while app.page == "explore" and app.world.camera.is_transitioning():
			app.world.camera._process(1.0/60.0)
			await process_frame

func capture(name: String) -> void:
	await frames()
	if not visual: return
	RenderingServer.force_draw(false)
	await process_frame
	root.get_texture().get_image().save_png("res://work/"+name+".png")

func run() -> void:
	create_timer(90).timeout.connect(func() -> void: push_error("TEST TIMEOUT"); quit(2))
	for path in ["res://work/ui-progress.json","res://work/test-progress.json"]:
		if FileAccess.file_exists(path): DirAccess.remove_absolute(path)
	var planets := Catalog.load_planets()
	check(planets.size() == 8,"Catalog contains 8 planets")
	for p in planets:
		var start := Catalog.orbital_position(p.a_au,p.eccentricity,0)
		var end := Catalog.orbital_position(p.a_au,p.eccentricity,Catalog.mean_anomaly(p.period_years*365.25,p.period_years))
		check(start.distance_to(end) < .0001,"Orbit closes after one period: "+p.id)
		check(absf(start.length()-p.a_au*(1-p.eccentricity)) < .0001,"Perihelion: "+p.id)
		var apo := Catalog.orbital_position(p.a_au,p.eccentricity,PI)
		check(absf(apo.length()-p.a_au*(1+p.eccentricity)) < .0001,"Aphelion: "+p.id)
	var store = Store.new()
	store.path = "res://work/test-progress.json"
	store.visit("earth")
	store.visit("earth")
	store.complete("day")
	var reloaded = Store.new()
	reloaded.path = store.path
	reloaded.load_progress()
	check(reloaded.data.visited.size() == 1,"Visits are idempotent and persisted")
	check(reloaded.data.lessons.has("day"),"Lesson persisted")
	var legacy := FileAccess.open(store.path,FileAccess.WRITE)
	legacy.store_string(JSON.stringify({"schema_version":1,"selected":"mars","visited":["earth","mars"],"lessons":["day"]}))
	legacy.close()
	var migrated = Store.new()
	migrated.path = store.path
	migrated.load_progress()
	check(migrated.data.visited.size() == 2 and migrated.data.lessons.has("day") and migrated.data.tasks.is_empty() and migrated.data.comparisons.is_empty(),"Legacy records migrate without losing progress")
	var bad := FileAccess.open(store.path,FileAccess.WRITE)
	bad.store_string("broken")
	bad.close()
	var recovery = Store.new()
	recovery.path = store.path
	recovery.load_progress()
	check(not recovery.error_message.is_empty() and recovery.data.visited.is_empty(),"Corrupt storage recovers")
	app = load("res://scenes/main.tscn").instantiate()
	# Isolate test learning records from the real app.
	app.progress.path = "res://work/ui-progress.json"
	app.quality.path = "res://work/test-quality.cfg"
	app.audio.path = "res://work/run_tests-audio.cfg"
	app.quality.set_level(0)
	root.add_child(app)
	app.audio.set_enabled(false,false)
	check(app.page == "home","Startup opens departure page")
	app._body.get_node("HomePage").primary_button.pressed.emit()
	await frames()
	check(app.world.bodies.size() == 8,"8 rendered planets")
	check(app.quality.level == 0 and app.viewport.msaa_3d == Viewport.MSAA_DISABLED,"Startup applies saved quality to the first exploration view")
	app._set_quality(2)
	check(app.page == "explore" and app.world.camera.follow_node == null,"Initial exploration shows overview")
	app.world.select_body(2,true)
	await frames()
	check(app.world.bodies[2].has_node("Clouds") and app.world.bodies[2].has_node("Atmosphere"),"Earth has cloud and atmosphere layers")
	check(app._planet_buttons.size() == 8,"Eight navigable thumbnails")
	for p in planets:
		check(ResourceLoader.exists("res://assets/thumbnails/"+p.id+".png"),"Baked thumbnail: "+p.id)
	app.world.set_orbits(false)
	check(not app.world.orbits[0].visible,"Orbit toggle hides orbit geometry")
	app.world.set_orbits(true)
	app._toggle_pause()
	check(not app.world.paused,"Continue starts the simulation")
	app._toggle_pause()
	check(app.world.paused,"Pause stops the simulation")
	check(app._planet_grid.get_global_rect().end.y < app.size.y,"Landscape thumbnail tray fits on first screen")
	await capture("earth-v032")
	# Camera gesture contract: dragging changes angle, pinch changes distance.
	var camera = app.world.camera
	var before_yaw: float = camera.yaw
	var press := InputEventScreenTouch.new()
	press.index = 0
	press.position = Vector2(100,100)
	press.pressed = true
	camera._input(press)
	var drag := InputEventScreenDrag.new()
	drag.index = 0
	drag.position = Vector2(130,100)
	drag.relative = Vector2(30,0)
	camera._input(drag)
	check(not is_equal_approx(camera.yaw,before_yaw),"Touch drag rotates camera")
	press.index = 1
	press.position = Vector2(230,100)
	camera._input(press)
	var before_distance: float = camera.distance
	drag.index = 1
	drag.position = Vector2(260,100)
	drag.relative = Vector2(30,0)
	camera._input(drag)
	check(camera.distance < before_distance,"Pinch apart zooms in")
	camera.cancel_gestures()
	check(camera._touches.is_empty(),"Gesture state clears on navigation")
	app.world.select_body(2,true)
	root.size = Vector2i(1280,720)
	await frames()
	check(app._planet_grid.get_global_rect().end.y < app.size.y,"16:9 tray fits on first screen")
	await capture("wide-v03")
	root.size = Vector2i(1152,720)
	await frames()
	app.navigate("explore")
	await frames()
	app.world.paused = true
	var time_before: float = app.world.days
	await frames()
	check(is_equal_approx(app.world.days,time_before),"Paused clock")
	app._planet_buttons[5].pressed.emit()
	await frames()
	check(app.selected_index == 5 and app.world.camera.follow_node == app.world.bodies[5],"Selection focuses Saturn")
	check(app._planet_grid.get_global_rect().end.y < app.size.y,"Saturn card keeps navigation on screen")
	await capture("saturn-v032")
	var before_transition: Vector3 = app.world.camera.position
	app.world.reset_view()
	check(app.world.camera.is_transitioning(),"Overview starts smooth transition")
	check(app.world.camera.position.distance_to(before_transition) < .01,"Transition starts without jumping")
	check(is_equal_approx(app.world.bodies[5].scale.x,1.0),"Departure planet does not abruptly enlarge")
	# Sample a fixed fraction before yielding so a slow frame cannot skip the middle pose.
	camera._process(camera.transition_duration * .25)
	var intermediate_position: Vector3 = camera.position
	check(camera.is_transitioning() and intermediate_position.distance_to(before_transition) > .01,"Camera moves through an intermediate pose")
	await capture("explore-v032")
	check(not camera.is_transitioning() and camera.position.distance_to(intermediate_position) > .01,"Camera transition settles past the intermediate pose")
	check(app.world.bodies.all(func(body): return body.visible),"Overview restores every planet")
	var bounds: Rect2 = app.viewport.get_visible_rect()
	for body in app.world.bodies:
		check(bounds.has_point(app.world.camera.unproject_position(body.global_position)),"Overview fits planet: "+body.name)
	for i in range(1,planets.size()):
		var inner: Dictionary = planets[i-1]
		var outer: Dictionary = planets[i]
		check(outer.display_a*(1-outer.eccentricity)-inner.display_a*(1+inner.eccentricity) > 6,"Display orbital bands are separated")
	app.world.select_body(0,true)
	await frames()
	var camera_position: Vector3 = app.world.camera.position
	app.world.select_body(4,true)
	check(app.world.camera.is_transitioning(),"Planet switching animates")
	var takeover := InputEventMouseButton.new()
	takeover.button_index = MOUSE_BUTTON_LEFT
	takeover.pressed = true
	takeover.position = Vector2(50,50)
	app.world.camera._input(takeover)
	check(not app.world.camera.is_transitioning(),"Gesture interrupts camera animation")
	check(camera_position.distance_to(app.world.camera.position) < .01,"Taking over preserves camera pose")
	app.world.camera.cancel_gestures()
	app.world.select_body(0,true)
	await frames()
	var zoom := InputEventMouseButton.new()
	zoom.pressed = true
	zoom.button_index = MOUSE_BUTTON_WHEEL_UP
	for i in range(100): app.world.camera._input(zoom)
	check(is_equal_approx(app.world.camera.distance,app.world.camera.min_distance),"Near zoom boundary")
	zoom.button_index = MOUSE_BUTTON_WHEEL_DOWN
	for i in range(100): app.world.camera._input(zoom)
	check(is_equal_approx(app.world.camera.distance,app.world.camera.max_distance),"Far zoom boundary")
	app.world.camera.restore_view()
	await frames()
	check(app.world.camera.follow_node == app.world.bodies[0],"Restore keeps selected planet")
	check(not app.world.bodies[4].visible and not app.world.sun.visible,"Close-up isolates selected planet")
	app.world.select_body(5,true)
	check(is_equal_approx(app.world.bodies[5].scale.x,1.0),"Close-up restores native body size")
	app.world.reset_view()
	var state_days: float = app.world.days
	app._open_lesson("day")
	await frames()
	app._change_angle(0)
	check(app._canvas.status().contains("黑夜"),"0 degrees night")
	app._change_angle(90)
	check(app._canvas.status().contains("交界"),"90 degrees boundary")
	app._change_angle(180)
	check(app._canvas.status().contains("白天"),"180 degrees day")
	app._answer_question("地球公转")
	check(app._feedback.text.contains("再试一次"),"Incorrect answer feedback")
	app._answer_question("地球自转")
	check(app.progress.data.lessons.has("day"),"Correct answer saves lesson")
	app._reset_lesson()
	app._set_playing(true)
	app._process(1.0)
	check(app._angle >= 210,"Lesson playback advances angle")
	app._set_playing(false)
	var paused_angle: float = app._angle
	app._process(1.0)
	check(app._angle == paused_angle,"Lesson pause holds angle")
	app._reset_lesson()
	check(app._angle == 180 and not app._playing,"Reset restores day experiment")
	await capture("day-v05")
	app._set_playing(true)
	for i in range(60): app._process(1.0/60.0)
	check(is_equal_approx(app._angle,210),"Playback advances at 60 fps")
	app._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	app._process(1.0)
	check(not app._playing and is_equal_approx(app._angle,210),"Background pauses lesson")
	app._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
	app._answer_question("地球自转")
	check(app._summary.get_child_count() == 3,"Completed lesson offers summary and next steps")
	await capture("day-complete-v05")
	app._open_lesson("year")
	app._change_angle(120)
	await capture("year-v05")
	app._open_lesson("day")
	check(is_equal_approx(app._angle,210) and app._answer == "地球自转","Switching lessons retains angle and answer")
	app._open_lesson("year")
	check(is_equal_approx(app._angle,120),"Year retains independent position")
	app.navigate("compare")
	app._go_back()
	check(app.page == "lab" and is_equal_approx(app._angle,120),"Back returns to experiment with state")
	# Native window focus can change during screenshot capture; explicitly set
	# the foreground precondition for this manually advanced playback check.
	app._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
	app._change_angle(359.6)
	app._set_playing(true)
	app._process(1.0/60.0)
	check(app._angle == 360 and not app._playing,"Playback reaches exact completion without rounding early")
	app._open_lesson("year")
	app._change_angle(360)
	check(app.progress.data.lessons.has("year"),"Orbit completion saved")
	app.navigate("explore")
	await frames()
	check(is_equal_approx(app.world.days,state_days),"Experiment does not change exploration time")
	app.navigate("compare")
	await frames()
	var radii = app._canvas.comparison_radii()
	check(is_equal_approx(radii.y/radii.x,planets[4].radius_km/planets[2].radius_km),"Comparison preserves actual diameter ratio")
	app._select_comparison_slot(0)
	check(app._comparison_buttons[2].get_node("SelectionOverlay").badge == "A" and app._comparison_buttons[4].get_node("SelectionOverlay").badge == "B","Both selected planets show their assignment")
	app._swap_comparison()
	check(app._compare_slot == 0 and app._slot_buttons[0].button_pressed,"Swap preserves active replacement slot")
	check(app._comparison_buttons[4].get_node("SelectionOverlay").badge == "A" and app._comparison_buttons[2].get_node("SelectionOverlay").badge == "B","Swap refreshes assignment badges")
	check(app._compare_first == 4 and app._compare_second == 2,"Swap exchanges both comparison objects")
	app._select_comparison_slot(1)
	app._comparison_buttons[4].pressed.emit()
	check(app._compare_second == 4,"Thumbnail changes selected comparison slot")
	check(is_equal_approx(app._canvas.comparison_radii().x,app._canvas.comparison_radii().y),"Same planet renders equal radii")
	check(app._comparison_buttons[4].get_node("SelectionOverlay").badge == "AB","Same planet shows combined assignment")
	app._choose_comparison(0,2)
	app.navigate("home")
	app._go_back()
	check(app.page == "compare" and app._compare_first == 2 and app._compare_second == 4,"Comparison state survives navigation")
	await capture("compare-v05")
	app._canvas.mode = "distance"
	app._canvas.queue_redraw()
	await capture("distance-v04")
	root.size = Vector2i(800,1100)
	app.navigate("explore")
	await frames()
	app._responsive()
	await capture("portrait-v03")
	check(app._split.vertical,"Portrait stacks panels")
	check(app._planet_grid.columns == 4,"Portrait uses four thumbnail columns")
	root.size = Vector2i(390,844)
	await frames()
	app.navigate("explore")
	await capture("phone-explore-v03")
	app.navigate("compare")
	await capture("phone-compare-v04")
	app.navigate("lab")
	await capture("phone-v05")
	check(app.get_rect().size.x < 500,"Phone uses compact logical viewport")
	root.size = Vector2i(1280,800)
	app.navigate("home")
	await frames()
	await capture("home-v05")
	app._set_quality(0)
	check(app.viewport.msaa_3d == Viewport.MSAA_DISABLED,"Low quality disables MSAA")
	check(not app.world.bodies[2].get_node("Clouds").visible,"Low quality disables clouds")
	var settings = load("res://scripts/quality_settings.gd").new()
	settings.path = app.quality.path
	settings.load_settings()
	check(settings.level == 0,"Quality setting persists")
	app._set_quality(2)
	check(app.viewport.msaa_3d == Viewport.MSAA_4X and app.world.sun_glow.visible,"High quality enables MSAA and solar glow")
	check(app.world.bodies[2].get_node("Atmosphere").visible,"High quality restores atmosphere")
	app.navigate("explore")
	app.world.reset_view()
	await capture("overview-v06")
	check(app.world.camera.projection == Camera3D.PROJECTION_ORTHOGONAL,"Overview uses consistent-scale projection")
	var overview_size: float = app.world.camera.size
	app.world.camera.zoom_by(.8)
	check(app.world.camera.size < overview_size,"Overview zoom changes the rendered scale")
	app.world.camera.zoom_by(1.25)
	check(is_equal_approx(app.world.camera.size,overview_size),"Overview zoom out restores scale")
	for repeat in range(80): app.world.camera.zoom_by(.8)
	check(is_equal_approx(app.world.camera.distance,app.world.camera.min_distance),"Overview minimum zoom limit")
	for repeat in range(80): app.world.camera.zoom_by(1.25)
	check(is_equal_approx(app.world.camera.distance,app.world.camera.max_distance),"Overview maximum zoom limit")
	app.world.camera.restore_view()
	await frames()
	# Layout can settle by one pixel while the camera restores. Validate the fit
	# for the current viewport, not a snapshot from before that resize.
	check(is_equal_approx(app.world.camera.size,app.world.camera._overview_size) and is_equal_approx(app.world.camera.distance,app.world.camera._overview_distance),"Restore returns to fitted overview")
	app.world.select_body(7)
	app.world.set_region("inner")
	await frames()
	check(app.world.bodies.filter(func(body): return body.visible).size() == 4 and app.world.selected_index == 2,"Inner region shows four planets and selects a visible body")
	check(app.world.orbits.filter(func(orbit): return orbit.visible).size() == 4,"Inner region filters orbits")
	app.world.set_region("outer")
	await frames()
	check(not app.world.bodies[2].visible and app.world.bodies[7].visible,"Outer region hides inner planets")
	app.world.select_body(2)
	await frames()
	check(app.world.region == "all" and app.world.bodies[2].visible and app.world.camera.follow_node == null,"Selecting outside region restores overview visibility")
	app._planet_buttons[7].pressed.emit()
	check(app.world.selected_index == 7 and app.world.camera.follow_node == null,"Overview thumbnail selects without forcing close-up")
	app._view_buttons["close"].pressed.emit()
	await frames()
	check(app.world.camera.projection == Camera3D.PROJECTION_PERSPECTIVE and app.world.camera.follow_node == app.world.bodies[7],"Close-up button restores perspective and focus")
	app.world.set_region("all")
	await frames()
	app.world.select_body(5,true)
	await capture("saturn-v06")
	var quality_button := app._body.find_child("GraphicsQuality",true,false) as Button
	check(is_instance_valid(quality_button),"Explore toolbar exposes the quality settings")
	if is_instance_valid(quality_button): quality_button.pressed.emit()
	check(app._settings.visible,"Quality button opens the settings dialog")
	await capture("settings-v06")
	app._go_back()
	check(not app._settings.visible and app.page == "explore","Back closes settings before navigation")
	app.navigate("home")
	await frames()
	if visual:
		RenderingServer.force_draw(false)
		await process_frame
		check(app._showcase.texture != null and not app._showcase.is_processing(),"Static homepage artwork has no continuous rendering process")
	app._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	app._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
	check(not app.world.is_processing() and app.viewport.render_target_update_mode == SubViewport.UPDATE_DISABLED,"Home focus does not restart hidden exploration")
	var baseline_nodes := int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT))
	var baseline_orphans := int(Performance.get_monitor(Performance.OBJECT_ORPHAN_NODE_COUNT))
	var baseline_memory := OS.get_static_memory_usage()
	var started := Time.get_ticks_msec()
	for cycle in range(12):
		for destination in ["explore","lab","compare","home"]:
			app.navigate(destination)
			await frames()
	check(int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT)) == baseline_nodes,"48 page changes retain stable node count")
	check(int(Performance.get_monitor(Performance.OBJECT_ORPHAN_NODE_COUNT)) == baseline_orphans,"48 page changes retain stable orphan count")
	check(app._history.size() <= 32,"Navigation history stays bounded")
	var report := {"scope":"Desktop navigation resource stability, not Android FPS", "page_changes":48,"elapsed_ms":Time.get_ticks_msec()-started,"nodes_before":baseline_nodes,"nodes_after":int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT)),"orphans_before":baseline_orphans,"orphans_after":int(Performance.get_monitor(Performance.OBJECT_ORPHAN_NODE_COUNT)),"static_bytes_before":baseline_memory,"static_bytes_after":OS.get_static_memory_usage()}
	var report_file := FileAccess.open("res://work/performance-v06.json",FileAccess.WRITE)
	report_file.store_string(JSON.stringify(report,"  "))
	report_file.close()
	app._set_quality(1)
	# v0.7 learning flow uses isolated test storage.
	for p in planets:
		check(app.knowledge.has(p.id),"Knowledge card exists: "+p.id)
		for field in ["title","structure","atmosphere","moons","feature","source"]:
			check(not app.knowledge[p.id][field].is_empty(),"Knowledge field: "+p.id+"/"+field)
	app.selected_index = 1
	app.navigate("knowledge")
	for button in app._body.find_children("*","Button",true,false):
		if button.text.begins_with("展开"): button.button_pressed = true
	await capture("knowledge-v07")
	app._compare_with_earth()
	check(app._compare_first == 2 and app._compare_second == 1,"Compare current planet with Earth")
	app._compare_mode = "rotation"
	app.navigate("compare")
	var periods: Vector2 = app._canvas.period_values()
	check(periods.x > 0 and periods.y > 0 and is_equal_approx(periods.y,absf(planets[1].rotation_days)),"Retrograde rotation compares positive duration")
	await capture("rotation-v07")
	app._compare_mode = "period"
	app.navigate("compare")
	check(is_equal_approx(app._canvas.period_values().y,planets[1].period_years*365.25),"Orbital periods use Earth days")
	app._reset_learning()
	app._answer_task(0,0)
	check(app.progress.data.tasks.is_empty(),"Task cannot complete before prerequisites")
	for task_index in range(2):
		var task = app.Tasks.TASKS[task_index]
		for i in range(4): app._continue_task(task_index)
		app._continue_task(task_index)
		check(app.page == "compare" and app.progress.data.comparisons.has(task.comparison),"Task directs to required comparison")
		app.navigate("progress")
		app._answer_task(task_index,1-task.correct)
		check(not app.progress.data.tasks.has(task.id),"Incorrect task answer does not complete")
		app._answer_task(task_index,task.correct)
		check(app.progress.data.tasks.has(task.id),"Task completes after exploration comparison and answer")
	var saved = Store.new()
	saved.path = app.progress.path
	saved.load_progress()
	check(saved.data.tasks.size() == 2 and saved.data.comparisons.size() >= 2,"Task and comparison records persist")
	await capture("progress-v07")
	app._reset_dialog.popup_centered()
	app._go_back()
	check(app.progress.data.tasks.size() == 2 and not app._reset_dialog.visible,"Cancel reset preserves records")
	root.size = Vector2i(390,844)
	await frames()
	await capture("progress-phone-v07")
	app.navigate("knowledge")
	await capture("knowledge-phone-v07")
	app._reset_dialog.confirmed.emit()
	check(app.progress.data.visited.is_empty() and app.progress.data.tasks.is_empty() and app.progress.data.lessons.is_empty(),"Confirmed reset clears learning records")
	check(app.quality.level == 1,"Learning reset retains quality")
	saved.load_progress()
	check(saved.data.tasks.is_empty(),"Reset persists to disk")
	app.queue_free()
	await frames()
	await create_timer(.1).timeout
	if failures.is_empty(): print("PASS: 8 catalog entries, 24 orbit checks, storage recovery, navigation, camera gestures, transitions, zoom limits, restore view, pause, 60-fps lesson playback, background suspension, independent lesson state, completion summary, back navigation, comparison state, lessons, thumbnails, orbital spacing, overview framing, close-up isolation, 16:9 and portrait layout, eight knowledge cards, period units, retrograde duration, two task flows, legacy records, reset confirmation")
	else: print("FAIL: ",failures)
	quit(0 if failures.is_empty() else 1)
